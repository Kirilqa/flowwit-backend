# Uncomment and configure at least one provider below. Fine to enable more than
# one — only providers that are configured get created and registered. Agents
# referencing an unavailable provider simply fail to load (logged as a warning),
# the rest of the system keeps running.

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=

# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_TITLE=

# Ollama — local models, no API key needed. Only attempted at startup when this
# line is uncommented (presence is the opt-in signal, not the value) — point it
# at wherever Ollama is actually running; this is also its default local port.
# OLLAMA_BASE_URL=http://localhost:11434

# LM Studio — local models, same opt-in-via-presence rule as Ollama. The API
# key is optional: LM Studio only checks it if you've turned on "Require
# Authentication" in its own server settings — leave it unset otherwise.
# LMSTUDIO_BASE_URL=http://localhost:1234
# LMSTUDIO_API_KEY=

# --- Server ---------------------------------------------------------------
# SERVER_PORT=3000
# SERVER_HOST=0.0.0.0

# --- Entity storage paths ---------------------------------------------------
# All optional, defaults shown below. Relative to the process working directory.
# All default under ./data/ — mount or back up that one folder to persist
# everything (agents, skills, sessions, memory, workflows, scheduled tasks).
# SKILLS_PATH=./data/skills
# MCP_CONFIG_PATH=./data/mcp.json
# AGENT_CONFIG_PATH=./data/agents.json
# SESSIONS_PATH=./data/sessions
# WORKFLOWS_PATH=./data/workflows
# WORKFLOW_RUNS_PATH=./data/workflows/runs
# CHANNEL_CONFIG_PATH=./data/channels.json
# TELEGRAM_STATE_PATH=./data/telegram-state.json
# GUARDRAIL_RULES_PATH=./data/guardrail-rules.json
# SCHEDULED_TASKS_PATH=./data/scheduled-tasks.json
# SCHEDULED_TASK_RUNS_PATH=./data/scheduler/runs
# MEMORY_PATH=./data/memory
# MEMORY_PERSISTENT_MAX_LINES=200
# MEMORY_PERSISTENT_MAX_BYTES=25600

# --- User time zone ---------------------------------------------------------
# IANA time zone (e.g. Europe/Moscow) shown to agents alongside server time.
# If unset, agents only see server time, clearly labeled as such.
# USER_TIMEZONE=

# --- Channels ---------------------------------------------------------------
# Optional per-channel settings (see channels.json for the non-secret equivalent).
# WEB_CHANNEL_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_URL=
