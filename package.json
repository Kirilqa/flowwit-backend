{
    "name": "flowwit-backend",
    "version": "0.8.1",
    "description": "Multi-agent LLM platform with a visual workflow engine — chat with agents directly or build deterministic node-graph pipelines they execute step by step.",
    "author": "Kirilqa",
    "main": "dist/index.js",
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Kirilqa/flowwit-backend.git"
    },
    "bugs": {
        "url": "https://github.com/Kirilqa/flowwit-backend/issues"
    },
    "homepage": "https://github.com/Kirilqa/flowwit-backend#readme",
    "engines": {
        "node": ">=22"
    },
    "keywords": [
        "llm",
        "agent",
        "ai-agent",
        "workflow",
        "workflow-engine",
        "openai",
        "openrouter",
        "mcp",
        "telegram-bot"
    ],
    "scripts": {
        "start": "node dist/index.js",
        "build": "tsc && tsc-alias",
        "dev": "ts-node -r tsconfig-paths/register src/index.ts",
        "dev:watch": "ts-node-dev --respawn --transpile-only --require tsconfig-paths/register src/index.ts",
        "dev:check": "tsc --noEmit --skipLibCheck --watch",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "format": "prettier --write .",
        "check-format": "prettier --check .",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "prepublishOnly": "npm run build"
    },
    "license": "MIT",
    "type": "commonjs",
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/adm-zip": "^0.5.8",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.20.1",
        "@types/picomatch": "^4.0.3",
        "@types/turndown": "^5.0.6",
        "@typescript-eslint/eslint-plugin": "^8.38.0",
        "@typescript-eslint/parser": "^8.38.0",
        "eslint": "^9.32.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.3",
        "globals": "^17.11.0",
        "jest": "^30.0.5",
        "prettier": "^3.6.2",
        "ts-jest": "^29.4.0",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "tsc-alias": "^1.9.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "adm-zip": "^0.6.0",
        "ajv": "^8.20.0",
        "chokidar": "^5.0.0",
        "cron-parser": "^5.6.1",
        "dotenv": "^17.4.2",
        "fast-glob": "^3.3.3",
        "fastify": "^5.8.5",
        "grammy": "^1.44.0",
        "picomatch": "^4.0.4",
        "pino": "^10.3.1",
        "playwright": "^1.59.1",
        "ts-morph": "^28.0.0",
        "turndown": "^7.2.4",
        "yaml": "^2.9.0",
        "zod": "^4.3.6"
    }
}
